# === ReyniBio Media Server Configuration ===
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- User / Permissions ---
PUID=1000
PGID=1000
UMASK=002
TZ=Atlantic/Reykjavik

# --- Intel QuickSync (Jellyfin hardware transcoding) ---
# GID of the "render" group on the host. Auto-filled by setup.sh.
# Find manually with: getent group render | cut -d: -f3
RENDER_GID=

# --- Paths ---
DATA_DIR=/data
CONFIG_DIR=./config

# --- VPN (Gluetun) ---
# Your VPN provider credentials. Gluetun supports 24+ providers.
# See: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRY=

# --- VPN Port Forwarding (improves torrent speeds) ---
# Set to "on" if your provider supports it (ProtonVPN, AirVPN, etc.)
VPN_PORT_FORWARDING=off
# Only needed for some providers. Common values: protonvpn
VPN_PORT_FORWARDING_PROVIDER=

# --- Homarr (Dashboard) ---
# 64-character hex key for encrypting credentials. Generate with:
#   openssl rand -hex 32
HOMARR_SECRET_KEY=
